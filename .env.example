# --- Supabase (compartido) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- apps/api ---
PORT=3001
API_PORT=3001
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Opcional por ahora (sync Google Calendar y login Google local)
# El login de Google usa estas mismas credenciales vía supabase/config.toml.
# En Google Cloud, Authorized redirect URIs tiene que incluir:
#   http://127.0.0.1:54321/auth/v1/callback
#   http://localhost:3000/auth/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY=
GOOGLE_MAPS_API_KEY=
# Si la clave tiene restricciones de sitios web, usá el origen de producción:
GOOGLE_MAPS_HTTP_REFERER=

# --- apps/web (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PROXY_ORIGIN=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- apps/worker ---
WORKER_POLL_INTERVAL_MS=15000
WORKER_BATCH_SIZE=10
LOG_LEVEL=info

# --- apps/ai (LangGraph) ---
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=dev-ai-token-change-me
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
TAVILY_API_KEY=
